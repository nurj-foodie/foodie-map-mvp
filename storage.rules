rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos - users can only upload/update their own photos
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true; // Public read for profile photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Restaurant photos - public read, authenticated users can upload
    match /restaurant-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

