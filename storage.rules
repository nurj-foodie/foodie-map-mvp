rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos - users can only upload/update their own photos
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true; // Public read for profile photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Restaurant photos - public read, authenticated users can upload
    match /restaurant-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Beta reports screenshots - users can upload own, admins can read all
    match /beta-reports/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        // Admin check (same emails as Firestore rules)
        request.auth.token.email == 'nurj.media@gmail.com' ||
        request.auth.token.email == 'nurj.get@gmail.com' ||
        request.auth.token.email == 'nurj.ariffin@gmail.com'
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

