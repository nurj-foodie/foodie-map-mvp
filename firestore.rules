rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin (by email - Firebase project owners)
    // Defined once at top level for reuse across all collections
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'nurj.media@gmail.com' ||
        request.auth.token.email == 'nurj.get@gmail.com' ||
        request.auth.token.email == 'nurj.ariffin@gmail.com' ||
        request.auth.token.email == 'jihad.ariffin@gmail.com' // Testing admin
      );
    }
    
    // User documents - users can only access their own data, admins can read/write all
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin()
      );
    }
    
    // Eatery documents - public read/write for development (user submissions)
    match /eateries/{eateryId} {
      allow read: if true;
      allow create: if true; // Allow anonymous users to create for development
      allow update, delete: if true; // Allow anonymous users to update/delete for development
      // In production, use: if request.auth != null;
    }
    
    // Analytics documents - public write for development, authenticated read
    match /analytics/{analyticsId} {
      allow read: if request.auth != null;
      allow write: if true; // Allow anonymous analytics for development
      // In production, use: if request.auth != null;
    }
    
    // User favorites - users can only access their own favorites, admins can read all
    match /favorites/{favoriteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }
    
    // User reviews - users can create reviews, ONLY ADMIN can verify/reject (moderate)
    match /reviews/{reviewId} {
      allow read: if true; // Public read for reviews
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Only admin can update (verify/reject) - users cannot change verified status after creation
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // User check-ins - users can only access their own check-ins
    match /checkIns/{checkinId} {
      allow read: if true; // Public read for check-ins
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User points - users can only access their own points, admins can read all
    // Note: userPoints uses userId as document ID for total points, and userId as field for point history
    match /userPoints/{pointId} {
      // Allow read if document ID matches auth.uid (for total points) OR if userId field matches (for point history) OR admin
      allow read: if request.auth != null && (
        pointId == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Allow create if userId field matches auth.uid (for point history entries)
      allow create: if request.auth != null && (
        pointId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
      // Allow update/delete if document ID matches OR userId field matches OR admin
      allow update, delete: if request.auth != null && (
        pointId == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // User achievements - users can only access their own achievements
    // Note: achievements collection is for achievement definitions (templates)
    match /achievements/{achievementId} {
      allow read: if true; // Public read for achievement definitions
      allow create, update, delete: if request.auth != null;
    }
    
    // User achievements - actual user achievements (userAchievements collection)
    match /userAchievements/{achievementId} {
      // Allow read if userId field matches auth.uid (for list queries with where('userId', '==', userId))
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User routes - users can only access their own routes
    match /userRoutes/{routeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Leaderboard - public read for gamification
    match /leaderboard/{leaderboardId} {
      allow read: if true; // Public read for leaderboard
      allow create, update, delete: if request.auth != null; // Authenticated users can update
    }
    
    // User streaks - users can only access their own streaks
    match /userStreaks/{streakId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User challenges - users can only access their own challenges
    match /userChallenges/{challengeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User notifications - users can only access their own notifications
    match /userNotifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User level ups - users can only access their own level ups
    match /userLevelUps/{levelUpId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User photos - users can only access their own photos
    match /photos/{photoId} {
      allow read: if true; // Public read for photos
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Restaurant edits - users can create edits, read their own edits, ONLY ADMIN can approve/reject
    match /restaurant_edits/{editId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Only admin can update (approve/reject) - users cannot change status after creation
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Social posts - public read, authenticated users can create
    match /socialPosts/{postId} {
      allow read: if true; // Public read for social feed
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Post likes - authenticated users only
    match /postLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Post comments - public read, authenticated users can create
    match /postComments/{commentId} {
      allow read: if true; // Public read for comments
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Post shares - authenticated users only
    match /postShares/{shareId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // User follows - authenticated users only
    match /userFollows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }
    
    // Test collection - for connection testing
    match /test/{testId} {
      allow read, write: if true; // Public access for development
    }
    
        // Saved routes - users can access their own routes, public read for development
        match /saved_routes/{routeId} {
          allow read: if true; // Public read for development
          allow create: if true; // Allow anonymous users to create for development
          allow update, delete: if true; // Allow anonymous users to update/delete for development
          // In production, use: if request.auth != null && request.auth.uid == resource.data.userId;
        }
        
        // Route cache - public read/write for development
        match /route_cache/{routeId} {
          allow read, write: if true; // Public access for development
          // In production, consider restricting write access
        }
        
        // Route index - public read/write for development
        match /route_index/{routeId} {
          allow read, write: if true; // Public access for development
          // In production, consider restricting write access
        }
        
        // Location index - public read/write for development (autocomplete)
        match /location_index/{locationId} {
          allow read, write: if true; // Public access for development
          // In production, consider restricting write access
        }
        
        // R&R stops - public read/write for development
        match /rnr_stops/{stopId} {
          allow read, write: if true; // Public access for development
          // In production, consider restricting write access
        }
        
        // Petrol stations - public read/write for development
        match /petrol_stations/{stationId} {
          allow read, write: if true; // Public access for development
          // In production, consider restricting write access
        }
        
        // User activities - public read/write for development
        match /user_activities/{activityId} {
          allow read, write: if true; // Public access for development
          // In production, use: if request.auth != null && request.auth.uid == resource.data.userId;
        }
    
    // Admin collections - admin only
    match /admin/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Keyword Learning Collections - NEW
    // Learned keywords: Public read (safe to share), public write for development
    match /learned_keywords/{keywordId} {
      allow read: if true; // Public read - learned keywords are safe to share
      allow create, update: if true; // Public write for development
      // In production, consider: if request.auth != null;
    }
    
    // Search analytics: Authenticated read, public write (privacy-focused, no personal data)
    match /search_analytics/{analyticsId} {
      allow read: if request.auth != null; // Only authenticated users can read analytics
      allow create: if true; // Public write for analytics tracking (privacy-focused)
      // In production, consider: if request.auth != null;
    }
    
    // Keyword statistics: Public read, public write for development
    match /keyword_stats/{statId} {
      allow read: if true; // Public read - keyword statistics
      allow create, update: if true; // Public write for development
      // In production, consider: if request.auth != null;
    }
    
    // ============================================
    // BETA PHASE COLLECTIONS
    // ============================================
    
    // Waitlist collection - public read for landing page count, users can create/update own, admins read/write all
    match /waitlist/{waitlistId} {
      // Allow public read for landing page count display (anonymous access)
      allow read: if true;
      allow create: if true; // Public create for waitlist signup (can be anonymous)
      allow update: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Referrals collection - users can create/read own, admins read/write all
    match /referrals/{referralId} {
      allow read: if request.auth != null && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referrerEmail == request.auth.token.email ||
        resource.data.referredEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if true; // Public create for referral tracking (can be anonymous)
      allow update: if request.auth != null && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referrerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // K-Coins transactions - users can read own, public create for waitlist, system/admins write
    match /kcoins_transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      // Allow public create for waitlist signups (anonymous access)
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Survey responses - users can create/read own, admins read/write all
    match /survey_responses/{responseId} {
      allow read: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        request.resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
    
    // Travel package draws - public read, admin write
    match /travel_draws/{drawId} {
      allow read: if true; // Public read for transparency
      allow create, update, delete: if isAdmin();
    }
    
    // Beta reports - users can create/read own, admins read/write all
    match /beta_reports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Email drips - system write, users read own, admins read/write all
    match /email_drips/{dripId} {
      allow read: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      // System can create (via Firebase Functions or server-side)
      allow create: if true; // Allow system to create email drip records
      allow update: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Community updates - public read, system/admin write
    match /community_updates/{updateId} {
      allow read: if true; // Public read for community updates
      allow create, update, delete: if isAdmin();
    }
    
    // Waves collection - admin only (wave management)
    match /waves/{waveId} {
      allow read: if isAdmin(); // Only admins can read waves
      allow create, update, delete: if isAdmin(); // Only admins can manage waves
    }
  }
}
