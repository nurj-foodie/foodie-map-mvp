# Environment variables - CRITICAL SECURITY
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
.env.backup.*
*.env.backup

# Sensitive configuration files
# Note: config.js files are OK to commit IF they use process.env (not hardcoded secrets)
# *config.js - REMOVED: Too broad, would ignore firebaseConfig.js which should be committed
*secret*
*password*
*credential*
# *admin* - REMOVED: Too broad, would ignore adminAuth.js which should be committed

